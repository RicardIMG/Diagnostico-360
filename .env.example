NODE_ENV=development
PORT=4173
HOST=0.0.0.0

# Banco: sqlite para desenvolvimento; mysql em produção.
DB_DIALECT=sqlite
SQLITE_PATH=./data/diagnostico360.sqlite
# DATABASE_URL=mysql://usuario:senha@host:3306/diagnostico360

# Armazenamento: local para desenvolvimento; s3 em produção.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/uploads
MAX_UPLOAD_MB=100
# S3_ENDPOINT=https://...
# S3_REGION=us-east-1
# S3_BUCKET=diagnostico360
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Obrigatórios em produção para criar o primeiro administrador.
BOOTSTRAP_TENANT_NAME=Diagnóstico 360
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@diagnostico360.local
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha

# Cookies e proxy reverso.
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_TTL_HOURS=12
